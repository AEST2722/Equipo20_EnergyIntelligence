   "source": [
    "if \"mun_agri_top_crop\" in pre:\n",
    "    vc = pre[\"mun_agri_top_crop\"].value_counts(); rare = vc[vc < 5].index\n",
    "    pre[\"mun_agri_top_crop_grp\"] = pre[\"mun_agri_top_crop\"].where(~pre[\"mun_agri_top_crop\"].isin(rare), \"OTROS\")\n",
    "    print(\"cultivo principal:\", pre[\"mun_agri_top_crop\"].nunique(), \"->\", pre[\"mun_agri_top_crop_grp\"].nunique(), \"categorías\")"
   ]
