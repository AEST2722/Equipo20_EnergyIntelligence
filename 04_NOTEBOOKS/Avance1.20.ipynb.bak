   ],
   "source": [
    "desc = df[[\"tdpa\", TARGET] + num].describe(percentiles=[.05, .25, .5, .75, .95]).T\n",
    "desc[\"skew\"] = df[[\"tdpa\", TARGET] + num].skew(); desc[\"cv\"] = desc[\"std\"] / desc[\"mean\"].abs()\n",
    "desc.round(3)"
   ]
  },
